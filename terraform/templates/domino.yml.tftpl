# ==============================================================================
# Domino Data Lab ${domino_version} on Google Cloud Platform (GKE)
# Generated Installer Configuration (Schema 1.16)
# Target Agent Version: ${fleetcommand_agent_tag}
# ==============================================================================
schema: '1.16'
name: ${deploy_id}
hostname: ${domino_hostname}

namespace:
  platform: ${namespace_platform}
  compute: ${namespace_compute}
  system: ${namespace_system}

storage_class:
  block:
    create: true
    default: 'true'
    name: dominodisk
    type: gce
    access_modes:
      - ReadWriteOnce
    volume_binding_mode: WaitForFirstConsumer
  shared:
    create: true
    name: dominoshared
    type: nfs
    access_modes:
      - ReadWriteMany
    nfs:
      mount_path: ${shared_nfs_mount_path}
      server: ${shared_nfs_server}

blob_storage:
  default:
    type: shared
  projects:
    type: shared
  logs:
    type: shared
  backups:
    type: gcs
    gcs:
      region: ''
      bucket_name: ${google_bucket_name}
      service_account_name: ${google_platform_sa_account_id}
      project_name: ${google_project}

autoscaler:
  enabled: true
  cloud_provider: gcp
  gcp: {}

external_dns:
  enabled: false

email_notifications:
  enabled: false
  server: ''
  port: 587
  enable_ssl: false
  from_address: ''
  authentication:
    username: ''
    password: ''

monitoring:
  prometheus_metrics: true
  node_exporter: true
  kube_state_metrics: true
  istio:
    enabled: false
    install: false
    cni: false
  newrelic:
    apm: false
    infrastructure: false
    license_key: ''

helm:
  version: '3'
  host: quay.io
  namespace: domino
  username: '<QUAY_USERNAME>'
  password: '<QUAY_PASSWORD>'
  cache_path: /root/.ParallelDominoHelm
  image_registries:
    - server: quay.io
      username: '<QUAY_USERNAME>'
      password: '<QUAY_PASSWORD>'
    - server: mirrors.domino.tech
      username: '<QUAY_USERNAME>'
      password: '<QUAY_PASSWORD>'

image_caching:
  enabled: true

certificate_management:
  install: true
  SelfSigned: true
  Acme: false

elasticsearch:
  enable_sysctl: true

image_building:
  verbose: false
  rootless: false
  cache_storage_size: 70G
  cache_storage_retention: 50G
  cloud_registry_auth:
    gcp:
      service_account: ${google_gcr_service_account}

external_docker_registry:
  url: ${google_artifact_registry}
  username: _json_key
  password: '<BASE64_ENCODED_SERVICE_ACCOUNT_KEY_OR_USE_GCR_CREDENTIAL_REFRESHER>'

internal_docker_registry:
  s3_override: null
  gcs_override:
    bucket: ${google_bucket_name}
    service_account_name: ${google_platform_sa_account_id}
    project_name: ${google_project}
  azure_blobs_override: null

telemetry:
  mixpanel:
    enabled: true
    redacted_mode: false
  zendesk:
    enabled: false
    token: ''

gpu:
  enabled: ${gpu_enabled}

ingress_controller:
  class_name: nginx
  create: true

release_overrides:
  nginx-ingress:
    chart_values:
      controller:
        kind: Deployment
        hostNetwork: false
        config:
          ssl-cert: ${namespace_platform}/my-cert
          use-forwarded-headers: "true"
          enable-underscores-in-headers: "true"
          proxy-connect-timeout: "30"
          proxy-read-timeout: "3600"
          proxy-send-timeout: "3600"
        service:
          enabled: true
          type: LoadBalancer
          loadBalancerSourceRanges:
            - 0.0.0.0/0
          annotations: {}
          targetPorts:
            http: http
            https: https
%{ if platform_sizing_tier == "large" ~}
  # Large Domino Platform Overrides (Up to 600 Concurrent Executions)
  cluster-autoscaler:
    chart_values:
      resources:
        limits:
          cpu: 1
          memory: 2Gi
        requests:
          cpu: 50m
          memory: 100Mi
  cost-analyzer-prometheus:
    chart_values:
      server:
        resources:
          limits:
            memory: 8Gi
          requests:
            memory: 5Gi
  data-plane:
    chart_values:
      agent:
        deployment:
          resources:
            limits:
              memory: 4Gi
            requests:
              memory: 2Gi
  elasticsearch:
    chart_values:
      esJavaOpts: '-Xms4g -Xmx4g'
      replicas: 3
      resources:
        requests:
          cpu: 1
          memory: 8Gi
  git:
    chart_values:
      persistence:
        size: 160Gi
      resources:
        limits:
          cpu: 4
          memory: 4Gi
        requests:
          memory: 2Gi
  mongodb-replicaset:
    chart_values:
      persistentVolume:
        size: 120Gi
      resources:
        requests:
          cpu: 2
          memory: 4Gi
  nucleus:
    chart_values:
      config:
        javaMaxHeap:
          dispatcher: 5G
      keycloak: {}
      replicaCount:
        frontend: 3
      resources:
        dispatcher:
          limits:
            cpu: 5
            memory: 9Gi
          requests:
            cpu: 4
            memory: 9Gi
        train:
          limits:
            memory: 3Gi
          requests:
            memory: 3Gi
  prometheus:
    chart_values:
      server:
        resources:
          limits:
            memory: 14Gi
          requests:
            cpu: 1100m
            memory: 7Gi
  rabbitmq-ha:
    chart_values:
      resources:
        limits:
          cpu: 2
          memory: 6Gi
        requests:
          cpu: 1
          memory: 6Gi
%{ endif ~}
