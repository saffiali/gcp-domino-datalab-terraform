# the link https://docs.domino.ai/attachments/6.3/gke-main.tf returns HTTP 404.
# This file provides the exact root caller generated by Domino's ddlcloud_generator_gke
# for users who wish to invoke github.com/dominodatalab/terraform-gcp-gke remotely.

module "gke_cluster" {
  source = "github.com/dominodatalab/terraform-gcp-gke?ref=v3.1.3"

  project   = "your-gcp-project-id"
  deploy_id = "domino-gcp"
  location  = "us-central1"

  namespaces = {
    platform = "domino-platform"
    compute  = "domino-compute"
  }

  gke = {
    k8s_version              = "1.35."
    release_channel          = "STABLE"
    advanced_datapath        = true
    network_policies         = false
    vertical_pod_autoscaling = true
    public_access = {
      enabled = true
      cidrs   = ["0.0.0.0/0"]
    }
    kubeconfig = {
      path = "kubeconfig"
    }
  }

  storage = {
    filestore = {
      enabled  = true
      capacity = 1024
    }
    nfs_instance = {
      enabled  = false
      capacity = 100
    }
    gcs = {
      force_destroy_on_deletion = false
    }
    gcnv = {
      enabled           = false
      pool_capacity_gib = 1024
      trident_namespace = "trident"
      regional          = false
    }
  }

  node_pools = {
    platform = {
      min_count     = 1
      max_count     = 5
      initial_count = 2
      max_pods      = 60
      disk_size_gb  = 128
      image_type    = "COS_CONTAINERD"
      instance_type = "n2-highmem-8"
    }
    compute = {
      min_count     = 0
      max_count     = 10
      initial_count = 1
      max_pods      = 30
      disk_size_gb  = 400
      image_type    = "COS_CONTAINERD"
      instance_type = "n2-highmem-8"
    }
    gpu = {
      min_count       = 0
      max_count       = 2
      initial_count   = 0
      max_pods        = 30
      disk_size_gb    = 400
      image_type      = "COS_CONTAINERD"
      instance_type   = "n1-highmem-8"
      gpu_accelerator = "nvidia-tesla-t4"
    }
  }
}

output "google_filestore_ip_address" {
  value = module.gke_cluster.google_filestore_instance.ip_address
}

output "google_filestore_file_share" {
  value = "/${module.gke_cluster.google_filestore_instance.file_share}"
}

output "google_external_dns" {
  value = module.gke_cluster.dns
}

output "google_bucket_name" {
  value = module.gke_cluster.bucket_name
}

output "google_project" {
  value = module.gke_cluster.project
}

output "google_platform_service_account" {
  value = module.gke_cluster.service_accounts.platform.account_id
}

output "google_cluster_uuid" {
  value = module.gke_cluster.uuid
}

output "google_gcr_service_account" {
  value = module.gke_cluster.service_accounts.gcr.email
}

output "google_artifact_registry" {
  value = "${module.gke_cluster.domino_artifact_repository.location}-docker.pkg.dev/${module.gke_cluster.domino_artifact_repository.project}/${module.gke_cluster.domino_artifact_repository.repository_id}"
}

output "nfs_instance_ip" {
  value = module.gke_cluster.nfs_instance.ip_address
}

output "nfs_instance_path" {
  value = module.gke_cluster.nfs_instance.nfs_path
}

output "gcr_credential_refresher" {
  value = module.gke_cluster.gcr_credential_refresher
}
